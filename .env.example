# Optional per-machine defaults. Omit values to let pyOCD discover a single
# attached probe and target where possible.

# Whole or partial probe serial / unique ID (see `uv run pyocd list`). Used by
# ordinary connect routes; connect_under_reset ignores launch-environment overrides.
PYOCD_PROBE_UID=

# Optional target-type override (VENDOR-FIXED: pyOCD target registry).
# Prefer the selected board profile when one is available. connect_under_reset
# uses only its action target_override or persisted board target.
PYOCD_TARGET=
