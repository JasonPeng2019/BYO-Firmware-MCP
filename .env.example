# Optional per-machine defaults. Omit values to let pyOCD discover a single
# attached probe and target where possible.

# Whole or partial probe serial / unique ID (see `uv run pyocd list`). Consumed
# only by guarded launch-time override routes; ordinary `connect` and
# `connect_under_reset` ignore launch-environment overrides.
PYOCD_PROBE_UID=

# Optional target-type override (VENDOR-FIXED: pyOCD target registry).
# Prefer the selected board profile when one is available. Ordinary `connect`
# uses the persisted board target; `connect_under_reset` uses only its exact
# action target_override or persisted board target.
PYOCD_TARGET=

# Optional software-only Classical CAN fixture. Leave both empty to keep CAN
# off. Physical socketcan profiles are rejected in this release.
PYOCD_CAN_MODE=
PYOCD_CAN_CONFIG=
# Optional immutable source/runtime pins and bounded default read override.
PYOCD_CAN_CONFIG_SHA256=
PYOCD_CAN_RUNTIME_SHA256=
PYOCD_CAN_READ_SECONDS=
