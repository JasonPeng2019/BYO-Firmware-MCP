plan_defs.py:163: trailing whitespace.\n+        minimum,\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:164: trailing whitespace.\n+        maximum,\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:165: trailing whitespace.\n+        exclusive_minimum,\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:166: trailing whitespace.\n+        min_items,\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:167: trailing whitespace.\n+        max_items,\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:168: trailing whitespace.\n+        allow_empty,\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:169: trailing whitespace.\n+    )\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:170: trailing whitespace.\n+\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:171: trailing whitespace.\n+\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:172: trailing whitespace.\n+def _validate_setup_parameters(values: Mapping[str, object]) -> str | None:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:173: trailing whitespace.\n+    requires_uart = values.get(\"requires_uart\")\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:174: trailing whitespace.\n+    baudrate = values.get(\"serial_baudrate\")\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:175: trailing whitespace.\n+    serial_id = values.get(\"serial_id\")\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:176: trailing whitespace.\n+    if requires_uart is True and (baudrate is None or not serial_id):\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:177: trailing whitespace.\n+        return \"serial_baudrate and serial_id are required when requires_uart is true\"\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:178: trailing whitespace.\n+    if requires_uart is False and (baudrate is not None or serial_id is not None):\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:179: trailing whitespace.\n+        return \"serial_baudrate and serial_id must be NULL when requires_uart is false\"\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:180: trailing whitespace.\n+    return None\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:181: trailing whitespace.\n+\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:182: trailing whitespace.\n+\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:183: trailing whitespace.\n+def _validate_write_memory_parameters(values: Mapping[str, object]) -> str | None:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:184: trailing whitespace.\n+    target = values.get(\"symbol_or_address\")\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:185: trailing whitespace.\n+    is_address = isinstance(target, int) and not isinstance(target, bool)\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:186: trailing whitespace.\n+    if isinstance(target, str):\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:187: trailing whitespace.\n+        try:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:188: trailing whitespace.\n+            int(target, 0)\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:189: trailing whitespace.\n+        except ValueError:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:190: trailing whitespace.\n+            pass\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:191: trailing whitespace.\n+        else:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:192: trailing whitespace.\n+            is_address = True\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:193: trailing whitespace.\n+    elf_artifact = values.get(\"elf_artifact\")\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:194: trailing whitespace.\n+    if is_address:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:195: trailing whitespace.\n+        if elf_artifact is not None:\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:196: trailing whitespace.\n+            return \"elf_artifact must be NULL for a raw-address write\"\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:197: trailing whitespace.\n+        return None\r\nsrc/pyocd_debug_mcp/guardrails/plan_defs.py:198: trailing whitespace.\n+    if not isinstance(elf_artifact, str) or not elf_artifact.strip():\r\nsrc/pyo