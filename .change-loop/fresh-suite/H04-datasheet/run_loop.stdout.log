thoritative datasheet, call load_setup_tool for board_setup-plan, then populate this \"\r\nsrc/pyocd_debug_mcp\\guardrails\\plan_defs.py:699:                \"Confirm the full package-level MCU marking; for a fresh profile obtain the authoritative datasheet.\",\r\nsrc/pyocd_debug_mcp\\guardrails\\plan_defs.py:715:                \"datasheet_path\": \"C:/project/docs/datasheet.pdf\",\r\nsrc/pyocd_debug_mcp\\guardrails\\plan_defs.py:723:                \"datasheet plus verified support and bind it to the selected attached probe.\"\r\nsrc/pyocd_debug_mcp\\guardrails\\plan_defs.py:902:                \"Read the reference-manual/datasheet section.\",\r\nsrc/pyocd_debug_mcp\\guardrails\\plan_defs.py:1158:        \"package-level MCU part number and authoritative local datasheet, never a board type or \"\r\nsrc/pyocd_debug_mcp\\guardrails\\plan_defs.py:1166:        \"MCU part and authoritative local datasheet; exact pack/target support is resolved by the \"\r\nsrc/pyocd_debug_mcp\\setup_flow\\preflight.py:47:    datasheet_path: str = \"\"\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:236:class DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:251:    ) -> \"DeviceSupportCandidate\":\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:299:class BuiltInTargetSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:326:    def with_identity_proof(self, observed_cpuid: int) -> \"BuiltInTargetSupportCandidate\":\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:328:        return BuiltInTargetSupportCandidate(\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:437:DeviceSupportAuthority = DeviceSupportCandidate | BuiltInTargetSupportCandidate\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:570:) -> BuiltInTargetSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:575:    return BuiltInTargetSupportCandidate(\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:582:) -> BuiltInTargetSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:635:    if isinstance(candidate, BuiltInTargetSupportCandidate):\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:695:    ) -> tuple[DeviceSupportCandidate, ...]:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:699:        candidates: list[DeviceSupportCandidate] = []\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:726:                candidate = DeviceSupportCandidate.from_verified_pack(selected, binding)\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:732:    def resolve(self, part_number: str, targets: Iterable[str]) -> DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:762:def resolve_registered_pack_support(part_number: str) -> DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:789:) -> DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:793:    candidates: list[DeviceSupportCandidate] = []\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:819:            candidate = DeviceSupportCandidate.from_verified_pack(selected, authoritative_binding)\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:833:def resolve_project_pack_support(store: FirmStore, part_number: str) -> DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:845:def resolve_available_pack_support(store: FirmStore, part_number: str) -> DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:855:) -> DeviceSupportCandidate:\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:879:    candidates: dict[str, DeviceSupportCandidate] = {}\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:901:                candidate = DeviceSupportCandidate.from_verified_pack(selected, binding)\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:1071:    candidate: DeviceSupportCandidate, store: FirmStore | None\r\nsrc/pyocd_debug_mcp\\setup_flow\\device_support.py:1113:    candidate: DeviceSupportCandidate, store: FirmStore | None = None\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:135:                \"target, geometry, partition policy, pack/SVD/target, datasheet, or schema evidence changes.\"\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:391:        datasheet_path: str,\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:400:            datasheet_path=datasheet_path,\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:413:        datasheet_path: str,\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:437:            datasheet_path,\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:463:        datasheet_path: str,\r\nsrc/pyocd_debug_mcp\\tools\\setup.py:475:            datasheet_path,\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:40:    datasheet_sha256: str\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:61:                \"datasheet_sha256\": self.datasheet_sha256,\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:206:    datasheet_sha256: str,\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:208:    \"\"\"Resolve current pinned authorities for an already-reviewed datasheet digest.\"\"\"\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:214:    if datasheet_sha256 not in catalog.datasheet_sha256:\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:215:        raise BoardCatalogError(\"datasheet SHA-256 is not a reviewed catalog anchor\")\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:230:        expected_official_revision = f\"sha256:{datasheet_sha256}\"\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:232:            source.kind.value == \"datasheet\" and source.revision == expected_official_revision\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:236:                \"official evidence is not bound to the server-computed datasheet SHA-256\"\r\nsrc/pyocd_debug_mcp\\setup_flow\\reviewed_evidence.py:291:        datasheet_sha256,\r\n","exit_code":0,"status":"completed"}}
