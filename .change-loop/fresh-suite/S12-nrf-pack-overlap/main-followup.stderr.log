220-class CmsisPackDescription:
221-    """@brief Parser for the PDSC XML file describing a CMSIS-Pack.
222-    """
223-
224-    def __init__(self, pack: CmsisPack, pdsc_file: IO[bytes]) -> None:
225-        """@brief Constructor.
226-
227-        @param self This object.
228-        @param pack Reference to the CmsisPack instance.
229-        @param pdsc_file A file-like object for the .pdsc contained in _pack_.
230-        """
231-        self._pack = pack
232-
233-        # Convert PDSC into an ElementTree.
234-        self._pdsc = ElementTree(file=pdsc_file)
235-
236-        self._state_stack: List[_DeviceInfo] = []
237-        self._devices: List["CmsisPackDevice"] = []
238-
239:        # Remember if we have already warned about overlapping memory regions
240-        # so we can limit these to one warning per DFP
241:        self._warned_overlapping_memory_regions = False
242-
243-        # Extract devices.
244-        for family in self._pdsc.iter('family'):
245-            self._parse_devices(family)
246-
247-    @property
248-    def pack_name(self) -> Optional[str]:
249-        """@brief Name of the CMSIS-Pack.
250-        @return Contents of the required <name> element, or None if missing.
251-        """
252-        return self._pdsc.findtext('name')
253-
254-    @property
255-    def pack(self) -> CmsisPack:
256-        """@brief Reference to the containing CmsisPack object."""
257-        return self._pack
258-
259-    @property
260-    def pack_path(self) -> str:
261-        """@brief The file path or directory of the pack that defines this description."""
262-        return self._pack.pack_path if self._pack else ''
263-
264-    @property
265-    def devices(self) -> List["CmsisPackDevice"]:
266-        """@brief A list of CmsisPackDevice objects for every part number defined in the pack."""
267-        return self._devices
268-
269-    def _parse_devices(self, parent: Element) -> None:
270-        # Extract device description elements we care about.
271-        newState = _DeviceInfo(element=parent)
272-        children: List[Element] = []
273-        for elem in parent:
274:            if elem.tag == 'memory':
275-                newState.memories.append(elem)
276-            elif elem.tag == 'processor':
277-                newState.processors.append(elem)
278-            elif elem.tag == 'algorithm':
279-                newState.algos.append(elem)
280-            elif elem.tag == 'debug':
281-                newState.debugs.append(elem)
282-            elif elem.tag == 'sequences':
283-                newState.sequences += elem.findall('sequence')
284-            elif elem.tag == 'debugvars':
285-                newState.debugvars.append(elem)
286-            elif elem.tag == 'debugport':
287-                newState.debugports.append(elem)
288-            elif elem.tag in ('accessportV1', 'accessportV2'):
289-                newState.accessports.append(elem)
290-            elif elem.tag == 'flashinfo':
291-                newState.flashinfo.append(elem)
292-            # Save any elements that we will recurse into.
293-            elif elem.tag in ('subFamily', 'device', 'variant'):
294-                children.append(elem)
295-
296-        # Push the new device description state onto the stack.
297-        self._state_stack.append(newState)
298-
299-        # Create a device object if this element defines one.
300-        if parent.tag in ('device', 'variant'):
301-            # Build device info from elements applying to this device.
302-            deviceInfo = _DeviceInfo(element=parent,
303-                                        families=self._extract_families(),
304-                                        processors=self._extract_processors(),
305-                                        memories=self._extract_memories(),
306-                                        algos=self._extract_algos(),
307-                                        debugs=self._extract_debugs(),
308-                                        sequences=self._extract_sequences(),
309-                                        debugvars=self._extract_debugvars(),
310-                                        debugports=self._extract_debugports(),
311-                                        accessports=self._extract_accessports(),
312-                                        flashinfo=self._extract_flashinfo(),
313-                                        )
