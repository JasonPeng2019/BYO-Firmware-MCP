107-class CmsisPack:
108-    """@brief Wraps a CMSIS Device Family Pack.
109-
110-    This class provides a top-level interface for extracting device information from CMSIS-Packs.
111-    After an instance is constructed, a list of the devices described within the pack is available
112-    from the `devices` property. Each item in the list is a CmsisPackDevice object.
113-
114-    The XML element hierarchy that defines devices is as follows.
115-    ```
116-    family [-> subFamily] -> device [-> variant]
117-    ```
118-
119-    Internally, this class is responsible for collecting the device-related XML elements from each
120-    of the levels of the hierarchy described above. It determines which elements belong to each
121-    defined device and passes those to CmsisPackDevice. It is then CmsisPackDevice that performs
122-    the parsing of each element type into pyOCD-compatible data.
123-    """
124-    def __init__(self, file_or_path: Union[str, zipfile.ZipFile, IO[bytes], Path]) -> None:
125-        """@brief Constructor.
126-
127-        Opens the CMSIS-Pack and builds instances of CmsisPackDevice for all the devices
128-        and variants defined within the pack.
129-
130-        @param self
131-        @param file_or_path The .pack file to open. These values are supported:
132-            - String that is the path to a .pack file (a Zip file).
133-            - String that is the path to the root directory of an expanded pack.
134-            - `ZipFile` object.
135-            - File-like object that is already opened.
136-
137-        @exception MalformedCmsisPackError The pack is not a zip file, or the .pdsc file is missing
138-            from within the pack.
139-        """
140-        self._is_dir = False
141-        self._pack_path = ''
142-        if isinstance(file_or_path, zipfile.ZipFile):
143-            self._pack_file = file_or_path
144-            self._pack_path = file_or_path.filename or ''
145-        else:
146-            if isinstance(file_or_path, (str, Path)):
147-                path = Path(file_or_path).expanduser()
148-                self._pack_path = str(path)
149-                if path.is_dir():
150-                    self._is_dir = True
151-                    self._dir_path = path
152-                else:
153-                    file_or_path = path  # use expanded path for ZipFile
154-
155-            if not self._is_dir:
156-                try:
157-                    self._pack_file = zipfile.ZipFile(file_or_path, 'r')
158-                except zipfile.BadZipFile as err:
159-                    raise MalformedCmsisPackError(
160-                        f"Failed to open CMSIS-Pack '{self._pack_path or 'stream'}': {err}") from err
161-
162-        # Find and open the .pdsc file.
163-        if self._is_dir:
164-            for child_path in self._dir_path.iterdir():
165-                if child_path.suffix == '.pdsc':
166-                    self._pdsc_name = child_path.name
167-                    with child_path.open('rb') as pdsc_file:
168-                        self._pdsc = CmsisPackDescription(self, pdsc_file)
169-                    break
170-            else:
171-                raise MalformedCmsisPackError(f"CMSIS-Pack '{self._pack_path}' is missing a .pdsc file")
172-        else:
173-            for name in self._pack_file.namelist():
174-                if name.endswith('.pdsc'):
175-                    self._pdsc_name = name
176-                    with self._pack_file.open(name) as pdsc_file:
177-                        self._pdsc = CmsisPackDescription(self, pdsc_file)
178-                    break
179-            else:
180-                raise MalformedCmsisPackError(f"CMSIS-Pack '{self._pack_path}' is missing a .pdsc file")
181-
182-    @property
183-    def pack_path(self) -> str:
184-        """@brief The file path or directory of the pack root (zip file or expanded directory)."""
185-        return self._pack_path
186-
187-    @property
188-    def pdsc(self) -> "CmsisPackDescription":
189-        """@brief Accessor for the CmsisPackDescription instance for the pack's PDSC file."""
190-        return self._pdsc
191-
192-    @property
193-    def devices(self) -> List["CmsisPackDevice"]:
194-        """@brief A list of CmsisPackDevice objects for every part number defined in the pack."""
195-        return self._pdsc.devices
196-
197-    def get_file(self, filename: str) -> IO[bytes]:
198-        """@brief Return file-like object for a file within the pack.
199-
200-        @param self
201-        @param filename Relative path within the pack. May use forward or back slashes and '..'.
202-        @return A BytesIO object is returned that contains all of the data from the file
203-            in the pack. This is done to isolate the returned file from how the pack was
204-            opened (due to particularities of the ZipFile implementation).
205-        """
206-        filename = posixpath.normpath(filename.replace('\\', '/'))
207-
208-        # Some vendors place their pdsc in some subdirectories of the pack archive,
209-        # use relative directory to the pdsc file while reading other files.
210-        pdsc_base = self._pdsc_name.rsplit('/', 1)
211-        if len(pdsc_base) == 2:
212-            filename = f'{pdsc_base[0]}/{filename}'
213-
214-        if self._is_dir:
215-            path = self._dir_path / filename
216-            return io.BytesIO(path.read_bytes())
217-        else:
218-            return io.BytesIO(self._pack_file.read(filename))
