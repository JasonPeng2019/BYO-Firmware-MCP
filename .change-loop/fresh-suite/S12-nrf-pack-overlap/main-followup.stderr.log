96-def _get_part_number_from_element(element: Element) -> str:
97-    """@brief Extract the part number from a device or variant XML element."""
98-    assert element.tag in ("device", "variant")
99-    # Both device and variant may have 'Dname' according to the latest spec.
100-    if 'Dname' in element.attrib:
101-        return element.attrib['Dname']
102-    elif element.tag == "variant":
103-        return element.attrib['Dvariant']
104-    else:
105-        raise ValueError("element is neither device nor variant")
