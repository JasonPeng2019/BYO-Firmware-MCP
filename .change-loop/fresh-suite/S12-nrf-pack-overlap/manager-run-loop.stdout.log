erified_pack_for_candidate(candidate, store)\r\n1266-    if (\r\n1267-        selected.spec.id != candidate.pack_id\r\n1268-        or selected.spec.filename != candidate.pack_filename\r\n1269-        or selected.spec.sha256 != candidate.pack_sha256\r\n1270-    ):\r\n1271-        raise PackProvisionError(\r\n1272-            \"registered pack identity no longer matches the selected candidate\"\r\n1273-        )\r\n1274-    try:\r\n1275-        DeviceSupportResolver._validate_archive(selected)\r\n1276-        pack = CmsisPack(io.BytesIO(selected.payload))\r\n1277-        device = next(\r\n1278-            item\r\n1279-            for item in pack.devices\r\n1280-            if item.part_number.casefold() == candidate.pdsc_device.casefold()\r\n1281-        )\r\n1282-        regions = tuple(device.memory_map.regions)\r\n1283-    except StopIteration as exc:\r\n1284-        raise PackProvisionError(\"selected PDSC leaf disappeared from the verified pack\") from exc\r\n1285-    except PackProvisionError:\r\n1286-        raise\r\n1287-    except Exception as exc:\r\n1288-        raise PackProvisionError(f\"verified pack geometry could not be parsed: {exc}\") from exc\r\n1289-    flash_candidates = tuple(\r\n1290-        region for region in regions if str(region.type).casefold().endswith(\"flash\")\r\n1291-    )\r\n1292-    ram_candidates = tuple(\r\n1293-        region\r\n1294-        for region in regions\r\n1295-        if str(region.type).casefold().endswith(\"ram\") and bool(region.is_writable)\r\n1296-    )\r\n1297-\r\n1298-    rom_candidates = tuple(\r\n1299-        region for region in regions if str(region.type).casefold().endswith(\"rom\")\r\n1300-    )\r\n1301-    peripheral_candidates = tuple(\r\n1302-        region for region in regions if str(region.type).casefold().endswith(\"device\")\r\n","exit_code":0,"status":"completed"}}
