d,\n        flash_regions=flash_rows,\n        ram_regions=ram_rows,\n    )\n    safety_geometry = GenericMapGeometry(\n        tuple(AddressRange(row.start, row.end) for row in pack_geometry.flash_regions),\n        tuple(AddressRange(row.start, row.end) for row in pack_geometry.ram_regions),\n        erase_available=False,\n    )\n    return pack_geometry, safety_geometry\n\n\nclass CanonicalPackGeometryRegressionTests(unittest.TestCase):\n    def test_preferred_overlap_reaches_generic_map_without_tail_or_erase_authority(self) -> None:\n        pack_geometry, safety_geometry = _generic_geometry(\n            (\n                _Region(\"descriptive\", 0, 0x200000),\n                _Region(\"default boot\", 0, 0x100000, is_default=True, is_boot_memory=True),\n            ),\n            (_Region(\"RAM\", 0x20000000, 0x40000, type=\"RamRegion\"),),\n        )\n\n        self.assertEqual(\n            tuple((row.start, row.end) for row in pack_geometry.flash_regions), ((0, 0x100000),)\n        )\n        self.assertEqual(safety_geometry.physical_flash, (AddressRange(0, 0x100000),))\n        self.assertFalse(safety_geometry.contains_flash(AddressRange(0x100000, 0x100001)))\n        self.assertFalse(safety_geometry.erase_available)\n        self.assertEqual(safety_geometry.erase_sectors, ())\n\n    def test_disjoint_banks_remain_distinct_and_persist_deterministically_after_replay(self) -> None:\n        flash = (\n            _Region(\"bank two\", 0x4000, 0x1000),\n            _Region(\"bank one\", 0, 0x1000, is_default=True),\n        )\n        ram = (\n            _Region(\"RAM two\", 0x20004000, 0x1000, type=\"RamRegion\"),\n            _Region(\"RAM one\", 0x20000000, 0x1000, type=\"RamRegion\"),\n        )\n        first, first_map = _generic_geometry(flash, ram)\n        replayed, replayed_map = _generic_geometry(tuple(reversed(flash)), tuple(reversed(ram)))\n\n        self.assertEqual(first.flash_regions, replayed.flash_regions)\n        self.assertEqual(first