{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$ErrorActionPreference='\"'Stop'; Test-Path '.venv\\\\Scripts\\\\python.exe'; Test-Path '.venv\\\\bin\\\\python'; git diff -- src/pyocd_debug_mcp/setup_flow/device_support.py; Get-Content -Raw tests\\\\test_regression_s12_nrf_pack_overlap.py; Get-Content -Raw .change-loop\\\\fresh-suite\\\\S12-nrf-pack-overlap\\\\state\\\\regression_test_cmd;\"","aggregated_output":"True\r\nFalse\r\ndiff --git a/src/pyocd_debug_mcp/setup_flow/device_support.py b/src/pyocd_debug_mcp/setup_flow/device_support.py\nindex 657096d..61a67f0 100644\n--- a/src/pyocd_debug_mcp/setup_flow/device_support.py\n+++ b/src/pyocd_debug_mcp/setup_flow/device_support.py\n@@ -478,6 +478,70 @@ class PackAddressRegion:\n         }\n \n \n+def _canonical_physical_regions(\n+    candidates: Iterable[Any], *, memory_kind: str\n+) -> tuple[PackAddressRegion, ...]:\n+    \"\"\"Keep deterministic, non-overlapping physical PDSC descriptors whole.\"\"\"\n+\n+    def as_region(item: Any) -> PackAddressRegion:\n+        return PackAddressRegion(\n+            str(getattr(item, \"name\", str(item.type))),\n+            int(item.start),\n+            int(item.start + item.length),\n+            str(getattr(item, \"access\", \"r\")),\n+        )\n+\n+    def precedence(item: Any) -> tuple[int, int, int]:\n+        return (\n+            int(bool(getattr(item, \"is_default\", False))),\n+            int(bool(getattr(item, \"is_boot_memory\", False))),\n+            int(bool(getattr(item, \"is_testable\", False))),\n+        )\n+\n+    def order(item: Any) -> tuple[int, int, int, str, str, str]:\n+        rank = precedence(item)\n+        return (\n+            -rank[0],\n+            -rank[1],\n+            -rank[2],\n+            str(getattr(item, \"name\", \"\")).casefold(),\n+            str(getattr(item, \"name\", \"\")),\n+            str(getattr(item, \"access\", \"r\")),\n+        )\n+\n+    by_range: dict[tuple[int, int], Any] = {}\n+    for item in candidates:\n+        region = as_region(item)\n+        key = (region.start, region.end)\n+        existing = by_range.get(key)\n+        if existing is None or order(item) < order(existing):\n+            by_range[key] = item\n+\n+    accepted: list[tuple[Any, PackAddressRegion]] = []\n+    for item in sorted(by_range.values(), key=order):\n+        region = as_region(item)\n+        conflicts = tuple(\n+            (accepted_item, accepted_region)\n+            for accepted_item, accepted_region in accepted\n+            if region.start < accepted_region.end and accepted_region.start < region.end\n+        )\n+        if conflicts:\n+            highest_item, highest = conflicts[0]\n+            if precedence(item) == precedence(highest_item):\n+                raise PackProvisionError(\n+                    f\"ambiguous verified PDSC physical {memory_kind} descriptions overlap: \"\n+                    f\"[{region.start:#x}, {region.end:#x}) and \"\n+                    f\"[{highest.start:#x}, {highest.end:#x})\"\n+                )\n+            continue\n+        accepted.append((item, region))\n+    return tuple(\n+        sorted(\n+            (region for _, region in accepted), key=lambda item: (item.start, item.end, item.name)\n+        )\n+    )\n+\n+\n @dataclass(frozen=True, slots=True)\n class PackMemoryGeometry:\n     \"\"\"Conservative default memory geometry parsed from one verified PDSC leaf.\"\"\"\n@@ -1395,7 +1459,7 @@ def resolve_registered_pack_geometry(\n             str(getattr(item, \"access\", \"r\")),\n         )\n \n-    def canonical_memory_regions(candidates: tuple[Any, ...]) -> tuple[PackAddressRegion, ...]:\n+    def exact_memory_regions(candidates: tuple[Any, ...]) -> tuple[PackAddressRegion, ...]:\n         by_range: dict[tuple[int, int], PackAddressRegion] = {}\n         for item in sorted(candidates, key=lambda value: (int(value.start), str(value.name))):\n             region = memory_region(item)\n@@ -1407,9 +1471,9 @@ def resolve_registered_pack_geometry(\n         if _compatible_core_identity(device) is not None\n         else ()\n     )\n-    canonical_flash = canonical_memory_regions(flash_candidates)\n-    canonical_ram = canonical_memory_regions(ram_candidates)\n-    canonical_rom = canonical_memory_regions(rom_candidates)\n+    canonical_flash = _canonical_physical_regions(flash_candidates, memory_kind=\"flash\")\n+    canonical_ram = _canonical_physical_regions(ram_candidates, memory_kind=\"RAM\")\n+    canonical_rom = exact_memory_regions(rom_candidates)\n     peripheral_exclusions = (\n         *canonical_flash,\n         *canonical_ram,\n\"\"\"Regression coverage for canonical pack geometry entering generic safety maps.\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nimport unittest\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"src\"))\n\nfrom pyocd_debug_mcp.safety.map_build import GenericMapGeometry\nfrom pyocd_debug_mcp.safety.regions import AddressRange\nfrom pyocd_debug_mcp.setup_flow.device_support import (\n    PackMemoryGeometry,\n    _canonical_physical_regions,\n    _geometry_digest,\n)\n\n\n@dataclass(frozen=True)\nclass _Region:\n    name: str\n    start: int\n    length: int\n    type: str = \"FlashRegion\"\n    access: str = \"rwx\"\n    is_default: bool = False\n    is_boot_memory: bool = False\n    is_testable: bool = False\n\n\ndef _generic_geometry(\n    flash: tuple[_Region, ...], ram: tuple[_Region, ...]\n) -> tuple[PackMemoryGeometry, GenericMapGeometry]:\n    flash_rows = _canonical_physical_regions(flash, memory_kind=\"flash\")\n    ram_rows = _canonical_physical_regions(ram, memory_kind=\"RAM\")\n    pack_geometry = PackMemoryGeometry(\n        flash_rows[0].start,\n        flash_rows[0].end,\n        ram_rows[0].start,\n        ram_rows[0].end,\n        flash_regions=flash_rows,\n        ram_regions=ram_rows,\n    )\n    safety_geometry = GenericMapGeometry(\n        tuple(AddressRange(row.start, row.end) for row in pack_geometry.flash_regions),\n        tuple(AddressRange(row.start, row.end) for row in pack_geometry.ram_regions),\n        erase_available=False,\n    )\n    return pack_geometry, safety_geometry\n\n\nclass CanonicalPackGeometryRegressionTests(unittest.TestCase):\n    def test_preferred_overlap_reaches_generic_map_without_tail_or_erase_authority(self) -> None:\n        pack_geometry, safety_geometry = _generic_geometry(\n            (\n                _Region(\"descriptive\", 0, 0x200000),\n                _Region(\"default boot\", 0, 0x100000, is_default=True, is_boot_memory=True),\n            ),\n            (_Region(\"RAM\", 0x20000000, 0x40000, type=\"RamRegion\"),),\n        )\n\n        self.assertEqual(\n            tuple((row.start, row.end) for row in pack_geometry.flash_regions), ((0, 0x100000),)\n        )\n        self.assertEqual(safety_geometry.physical_flash, (AddressRange(0, 0x100000),))\n        self.assertFalse(safety_geometry.contains_flash(AddressRange(0x100000, 0x100001)))\n        self.assertFalse(safety_geometry.erase_available)\n        self.assertEqual(safety_geometry.erase_sectors, ())\n\n    def test_disjoint_banks_remain_distinct_and_persist_deterministically_after_replay(self) -> None:\n        flash = (\n            _Region(\"bank two\", 0x4000, 0x1000),\n            _Region(\"bank one\", 0, 0x1000, is_default=True),\n        )\n        ram = (\n            _Region(\"RAM two\", 0x20004000, 0x1000, type=\"RamRegion\"),\n            _Region(\"RAM one\", 0x20000000, 0x1000, type=\"RamRegion\"),\n        )\n        first, first_map = _generic_geometry(flash, ram)\n        replayed, replayed_map = _generic_geometry(tuple(reversed(flash)), tuple(reversed(ram)))\n\n        self.assertEqual(first.flash_regions, replayed.flash_regions)\n        self.assertEqual(first.ram_regions, r