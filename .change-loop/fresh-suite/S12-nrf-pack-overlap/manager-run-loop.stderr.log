--- REGRESSION CONTENT ---
"""Regression coverage for canonical pack geometry entering generic safety maps."""

from __future__ import annotations

import sys
import unittest
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from pyocd_debug_mcp.safety.map_build import GenericMapGeometry
from pyocd_debug_mcp.safety.regions import AddressRange
from pyocd_debug_mcp.setup_flow.device_support import (
    PackMemoryGeometry,
    _canonical_physical_regions,
    _geometry_digest,
)


@dataclass(frozen=True)
class _Region:
    name: str
    start: int
    length: int
    type: str = "FlashRegion"
    access: str = "rwx"
    is_default: bool = False
    is_boot_memory: bool = False
    is_testable: bool = False


def _generic_geometry(
    flash: tuple[_Region, ...], ram: tuple[_Region, ...]
) -> tuple[PackMemoryGeometry, GenericMapGeometry]:
    flash_rows = _canonical_physical_regions(flash, memory_kind="flash")
    ram_rows = _canonical_physical_regions(ram, memory_kind="RAM")
    pack_geometry = PackMemoryGeometry(
        flash_rows[0].start,
        flash_rows[0].end,
        ram_rows[0].start,
        ram_rows[0].end,
        flash_regions=flash_rows,
        ram_regions=ram_rows,
    )
    safety_geometry = GenericMapGeometry(
        tuple(AddressRange(row.start, row.end) for row in pack_geometry.flash_regions),
        tuple(AddressRange(row.start, row.end) for row in pack_geometry.ram_regions),
        erase_available=False,
    )
    return pack_geometry, safety_geometry


class CanonicalPackGeometryRegressionTests(unittest.TestCase):
    def test_preferred_overlap_reaches_generic_map_without_tail_or_erase_authority(self) -> None:
        pack_geometry, safety_geometry = _generic_geometry(
            (
                _Region("descriptive", 0, 0x200000),
                _Region("default boot", 0, 0x100000, is_default=True, is_boot_memory=True),
            ),
            (_Region("RAM", 0x20000000, 0x40000, type="RamRegion"),),
        )

        self.assertEqual(
            tuple((row.start, row.end) for row in pack_geometry.flash_regions), ((0, 0x100000),)
        )
        self.assertEqual(safety_geometry.physical_flash, (AddressRange(0, 0x100000),))
        self.assertFalse(safety_geometry.contains_flash(AddressRange(0x100000, 0x100001)))
        self.assertFalse(safety_geometry.erase_available)
        self.assertEqual(safety_geometry.erase_sectors, ())

    def test_disjoint_banks_remain_distinct_and_persist_deterministically_after_replay(self) -> None:
        flash = (
            _Region("bank two", 0x4000, 0x1000),
            _Region("bank one", 0, 0x1000, is_default=True),
        )
        ram = (
            _Region("RAM two", 0x20004000, 0x1000, type="RamRegion"),
            _Region("RAM one", 0x20000000, 0x1000, type="RamRegion"),
        )
        first, first_map = _generic_geometry(flash, ram)
        replayed, replayed_map = _generic_geometry(tuple(reversed(flash)), tuple(reversed(ram)))

        self.assertEqual(first.flash_regions, replayed.flash_regions)
        self.assertEqual(first.ram_regions, replayed.ram_regions)
        self.assertEqual(_geometry_digest(first), _geometry_digest(replayed))
        self.assertEqual(first_map.physical_flash, (AddressRange(0, 0x1000), AddressRange(0x4000, 0x5000)))
        self.assertEqual(
            first_map.physical_ram,
            (AddressRange(0x20000000, 0x20001000), AddressRange(0x20004000, 0x20005000)),
        )
        self.assertEqual(first_map.to_document(), replayed_map.to_document())


if __name__ == "__main__":
    unittest.main()

