!= \"action_batch\",\r\nsrc\\pyocd_debug_mcp\\kernel\\registry.py:389:                await self._send_tool_list_changed()\r\nsrc\\pyocd_debug_mcp\\kernel\\registry.py:398:    async def _send_tool_list_changed(self) -> None:\r\nsrc\\pyocd_debug_mcp\\kernel\\registry.py:404:        await session.send_tool_list_changed()\r\nsrc\\pyocd_debug_mcp\\kernel\\operations.py:489:    if tool_name == \"action_batch\":\r\nsrc\\pyocd_debug_mcp\\kernel\\operations.py:498:                if not isinstance(child_name, str) or child_name == \"action_batch\":\r\nsrc\\pyocd_debug_mcp\\kernel\\operations.py:653:            if tool_name == \"action_batch\" and board_id is not None:\r\nsrc\\pyocd_debug_mcp\\tools\\batch.py:46:        if name.casefold() == \"action_batch\":\r\nsrc\\pyocd_debug_mcp\\tools\\batch.py:48:                f\"actions[{index}] is a nested action_batch; nested batches are forbidden\"\r\nsrc\\pyocd_debug_mcp\\tools\\batch.py:91:    async def action_batch(board_id: str, actions: list[BatchChild]) -> str:\r\nsrc\\pyocd_debug_mcp\\tools\\batch.py:135:    return {\"action_batch\": action_batch}\r\nsrc\\pyocd_debug_mcp\\tools\\handshake.py:82:from those bindings, submit only the exact server-returned single-child action_batch fallback\r\nsrc\\pyocd_debug_mcp\\tools\\serial.py:419:        del on_exit  # RegistryFastMCP validates and owns finalizer execution.\r\nsrc\\pyocd_debug_mcp\\tools\\serial.py:443:        del on_exit  # RegistryFastMCP validates and owns finalizer execution.\r\n--- PROJECT TEST SETTINGS ---\r\n# BYO Server package metadata.\r\n[project]\r\nname = \"pyocd-debug-mcp\"\r\nversion = \"0.1.0\"\r\ndescription = \"Headless local MCP server for embedded debug and flash control via pyOCD\"\r\nreadme = \"README.md\"\r\nrequires-python = \">=3.10\"\r\ndependencies = [\r\n    \"httpx>=0.27\",\r\n    \"mcp>=1.2.0\",\r\n    \"psutil>=5.9\",\r\n    \"pyocd>=0.44.0\",\r\n    \"pyelftools>=0.33\",\r\n    \"pyserial>=3.5\",\r\n    \"python-dotenv>=1.0\",\r\n    \"pyy