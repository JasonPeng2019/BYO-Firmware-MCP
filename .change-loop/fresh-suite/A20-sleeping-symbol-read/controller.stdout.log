{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"@'\nfrom pyocd_debug_mcp.tools.memory import MemoryToolServices, _read_coherent_scalar\n\ndef make(calls, state, reader, resumer=lambda: None):\n    return MemoryToolServices(\n        runtime_for=lambda _: None, active_session_id=lambda _: None, duration_ms=lambda _: 0,\n        record_event=lambda *args, **kwargs: None, format_refusal=lambda refusal, **kwargs: '',\n        handle_for=lambda _: object(), symbol_artifact_for=lambda _: None,\n        find_symbols=lambda *_: (), resolve_symbol=lambda *_: None,\n        read_target_memory=lambda *_: (calls.append('read'), reader())[1],\n        read_target_block=lambda *_: [], write_target_memory=lambda *_: None,\n        check_memory_read=lambda *_: None,\n        get_state=lambda _: (calls.append('state'), state)[1],\n        halt=lambda _: calls.append('halt'),\n        resume=lambda _: (calls.append('resume'), resumer())[1],\n    )\n\ndef boom(kind, message):\n    return lambda: (_ for _ in ()).throw(kind(message))\n\ncalls=[]\nassert _read_coherent_scalar(make(calls, 'hAlTeD', lambda: 0), object(), 1, 32) == 0\nassert calls == ['state', 'read']\ncalls=[]\nassert _read_coherent_scalar(make(calls, 'sleeping', lambda: 7), object(), 1, 32) == 7\nassert calls == ['state', 'halt', 'read', 'resume']\ncalls=[]\ntry:\n    _read_coherent_scalar(make(calls, 'running', boom(ValueError, 'read failed')), object(), 1, 32)\nexcept ValueError as error:\n    assert str(error) == 'read failed'\nelse: raise AssertionError('missing read error')\nassert calls == ['state', 'halt', 'read', 'resume']\ncalls=[]\ntry:\n    _read_coherent_scalar(make(calls, 'running', lambda: 7, boom(OSError, 'resume failed')), object(), 1, 32)\nexcept OSError as error:\n    assert str(error) == 'resume failed'\nelse: raise AssertionError('missing resume error')\nassert calls == ['state', 'halt', 'read', 'resume']\ncalls=[]\ntry:\n    _read_coherent_scalar(make(calls, 'running', boom(ValueError, 'read failed'), boom(OSError, 'resume failed')), object(), 1, 32)\nexcept RuntimeError as error:\n    assert 'ValueError: read failed' in str(error)\n    assert 'OSError: resume failed' in str(error)\nelse: raise AssertionError('missing dual error')\nassert calls == ['state', 'halt', 'read', 'resume']\nprint('coherent lifecycle checks passed')\n'@ | uv run python -\n& .\\\\.venv\\\\Scripts\\\\python.exe -m pytest -q tests/test_server_trust_model_round_1.py tests/test_server_trust_model_round_3.py tests/test_server_trust_model_round_4.py\nif (\"'$LASTEXITCODE -eq 0) { uv run --group dev ruff check src tests }\nif ($LASTEXITCODE -eq 0) { uv run --group dev pyright }\nif ($LASTEXITCODE -eq 0) { git diff --check }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
