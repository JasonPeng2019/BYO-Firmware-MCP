esume is None:\n+        raise RuntimeError(\"Memory service lifecycle operations are not configured.\")\n+    if services.get_state(handle).upper() == \"HALTED\":\n+        return services.read_target_memory(handle, address, width)\n+\n+    services.halt(handle)\n+    try:\n+        value = services.read_target_memory(handle, address, width)\n+    except Exception as read_error:\n+        try:\n+            services.resume(handle)\n+        except Exception as resume_error:\n+            raise RuntimeError(\n+                f\"{type(read_error).__name__}: {read_error}; execution restoration failed \"\n+                f\"with {type(resume_error).__name__}: {resume_error}\"\n+            ) from read_error\n+        raise\n+    services.resume(handle)\n+    return value\n+\n+\n def _hash_artifact(path: Path) -> str:\n     digest = hashlib.sha256()\n     with path.open(\"rb\") as stream:\n@@ -280,7 +312,15 @@ def build_memory_handlers(\n         width: int = 32,\n         elf_artifact: str | None = None,\n     ) -> str:\n-        \"\"\"Read a mapped symbol; pass its project ELF after restart or before same-run flash.\"\"\"\n+        \"\"\"Read one mapped scalar symbol (width 8, 16, or 32 bits) from the selected board.\n+\n+        Use this when debug metadata identifies a variable; supply the current project ELF after a\n+        restart or before a same-run flash. A running or sleeping target is briefly halted for one\n+        coherent read and execution is restored before this tool returns; an already halted target\n+        remains halted. The returned text includes the resolved symbol and hexadecimal value. ELF,\n+        symbol, target-access, read, or restoration failures are reported honestly rather than as\n+        invented data: retry with the current ELF, reconnect the target, then retry the read.\n+        \"\"\"\n \n         started = time.monotonic()\n         runtime = services.runtime_for(board_id)\n@@ -378,7 +418,7 @@ def build_memory_handlers(\n   