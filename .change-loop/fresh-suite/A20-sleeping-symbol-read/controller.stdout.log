{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"\"C:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -LiteralPath 'src\\\\pyocd_debug_mcp\\\\tools\\\\execution.py' | Select-Object -First 85; rg -n -C 3 \\\"get_state=|halt=target_control|resume=target_control|target_control\\\\.get_state\\\" src\\\\pyocd_debug_mcp\\\\server.py src\\\\pyocd_debug_mcp\\\\tools\"","aggregated_output":"\"\"\"Revised Layer-2 target execution controls.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom collections.abc import Callable\r\nfrom dataclasses import dataclass\r\n\r\nfrom pyocd_debug_mcp.kernel.operations import wrap_layer2_response\r\n\r\n\r\n@dataclass(frozen=True, slots=True)\r\nclass ExecutionToolServices:\r\n    halt: Callable[[str], str]\r\n    resume: Callable[[str], str]\r\n    step: Callable[[str], str]\r\n    reset: Callable[[str, bool], str]\r\n    connect_under_reset: Callable[[str, str | None, str | None], str]\r\n\r\n\r\ndef build_execution_handlers(\r\n    services: ExecutionToolServices,\r\n) -> dict[str, Callable[..., str]]:\r\n    \"\"\"Build always-available and plan-guarded execution handlers.\"\"\"\r\n\r\n    def halt(board_id: str) -> str:\r\n        \"\"\"Halt the selected board's core.\"\"\"\r\n\r\n        return wrap_layer2_response(services.halt(board_id))\r\n\r\n    def resume(board_id: str) -> str:\r\n        \"\"\"Resume the selected board's core.\"\"\"\r\n\r\n        return wrap_layer2_response(services.resume(board_id))\r\n\r\n    def step(board_id: str) -> str:\r\n        \"\"\"Single-step and return the resulting program counter.\"\"\"\r\n\r\n        return wrap_layer2_response(services.step(board_id))\r\n\r\n    def reset_and_run(board_id: str) -> str:\r\n        \"\"\"Reset and execute from the reset vector without changing target security.\"\"\"\r\n\r\n        return wrap_layer2_response(services.reset(board_id, False))\r\n\r\n    def reset_and_halt(board_id: str) -> str:\r\n        \"\"\"Reset and halt at startup without changing target security.\"\"\"\r\n\r\n        return wrap_layer2_response(services.reset(board_id, True))\r\n\r\n    def connect_under_reset(\r\n        board_id: str,\r\n        probe_uid: str | None = None,\r\n        target_override: str | None = None,\r\n    ) -> str:\r\n        \"\"\"Assert wired reset, attach and halt, then release reset.\"\"\"\r\n\r\n        return wrap_layer2_response(\r\n            services.connect_under_reset(board_id, probe_uid, target_override)\r\n        )\r\n\r\n    return {\r\n        \"halt\": halt,\r\n        \"resume\": resume,\r\n        \"step\": step,\r\n        \"reset_and_run\": reset_and_run,\r\n        \"reset_and_halt\": reset_and_halt,\r\n        \"connect_under_reset\": connect_under_reset,\r\n    }\r\nsrc\\pyocd_debug_mcp\\server.py-1564-    with connection_manager.lock_for(board_id):\r\nsrc\\pyocd_debug_mcp\\server.py-1565-\r\nsrc\\pyocd_debug_mcp\\server.py-1566-        def operation() -> str:\r\nsrc\\pyocd_debug_mcp\\server.py:1567:            return target_control.get_state(_handle(board_id))\r\nsrc\\pyocd_debug_mcp\\server.py-1568-\r\nsrc\\pyocd_debug_mcp\\server.py-1569-        return _run_logged_tool(board_id, \"get_state\", {\"board_id\": board_id}, operation)\r\nsrc\\pyocd_debug_mcp\\server.py-1570-\r\n--\nsrc\\pyocd_debug_mcp\\server.py-2050-        connect_override=_connect_override_impl,\r\nsrc\\pyocd_debug_mcp\\server.py-2051-        disconnect=_legacy_disconnect,\r\nsrc\\pyocd_debug_mcp\\server.py-2052-        get_board_info=_legacy_get_board_info,\r\nsrc\\pyocd_debug_mcp\\server.py:2053:        get_state=_legacy_get_state,\r\nsrc\\pyocd_debug_mcp\\server.py-2054-    )\r\nsrc\\pyocd_debug_mcp\\server.py-2055-)\r\nsrc\\pyocd_debug_mcp\\server.py-2056-execution_tool_handlers = build_execution_handlers(\r\n","exit_code":0,"status":"completed"}}
