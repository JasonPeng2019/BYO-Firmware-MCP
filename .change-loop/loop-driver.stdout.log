       if len(elves) > 1 or len(maps) > 1\n+            else None\n+        ),\n     }\n \n \n@@ -370,7 +375,15 @@ def _artifact_assurance(\n         if artifacts.get(\"map\") is not None\n         else None\n     )\n-    known = {\"elf\", \"hex\", \"map\"}\n+    known = {\n+        \"elf\",\n+        \"hex\",\n+        \"map\",\n+        \"elf_candidates\",\n+        \"map_candidates\",\n+        \"artifact_selection\",\n+        \"artifact_selection_remedy\",\n+    }\n     opaque = {\n         role: \"existing-nonempty-file; format-not-interpreted\"\n         for role, path in artifacts.items()\n@@ -526,7 +539,9 @@ def run_build(args: argparse.Namespace) -> int:\n             )\n         else:\n             artifacts = _artifact_paths(build_dir, expected_root=created_build_root)\n-        if completed.returncode == 0 and not any(artifacts.values()):\n+        if completed.returncode == 0 and not any(\n+            artifacts.get(role) for role in (\"elf\", \"hex\", \"map\")\n+        ) and not any(artifacts.get(role) for role in (\"elf_candidates\", \"map_candidates\")):\n             raise RuntimeError(\n                 \"Native build succeeded without a declared or discoverable output. Declare any \"\n                 \"project-native output with --artifact ROLE=PATH.\"\ndiff --git a/src/pyocd_debug_mcp/server.py b/src/pyocd_debug_mcp/server.py\nindex ea690d9..9053198 100644\n--- a/src/pyocd_debug_mcp/server.py\n+++ b/src/pyocd_debug_mcp/server.py\n@@ -1256,13 +1256,16 @@ def _connect_under_reset_impl(\n                 board_id=board_id,\n                 session=_runtime_for(board_id),\n             )\n-        board = resolve_board_config(board_id, None)\n-        resolved_uid = _resolve_probe_uid_for_connect(board, probe_uid)\n+        # This recovery route is intentionally isolated from launch-time\n+        # overrides: the approved action and persisted board profile are its\n+        # entire routing authority.\n+        board = resolve_board_config(board