{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "user_facing_response"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked"
      ]
    },
    "user_facing_response": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    }
  }
}
