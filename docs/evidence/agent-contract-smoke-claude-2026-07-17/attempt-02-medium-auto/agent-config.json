{
  "schema_version": 1,
  "name": "claude",
  "command": [
    "claude",
    "-p",
    "--model",
    "claude-sonnet-4-5-20250929",
    "--effort",
    "medium",
    "--permission-mode",
    "auto",
    "--mcp-config",
    "{workspace}\\claude-mcp.json",
