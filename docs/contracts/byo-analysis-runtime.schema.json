{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BYO native analysis runtime mapping, schema version 1",
  "description": "Closed four-target syntax for analysis/runtime.json. Release files is the sole payload digest inventory. Strict JSON integer tokens, filesystem containment, exact case, modes/caller access, inventory/SBOM completeness, resource major/version agreement, native header identity and version probes require the semantic checks in ../code-analysis-runtime-manifest.md. There are no implicit defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "architecture", "programs"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "platform": { "type": "string", "enum": ["windows", "macos", "linux"] },
    "architecture": { "type": "string", "enum": ["x86_64", "aarch64"] },
    "programs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cppcheck", "clangd"],
      "properties": {
        "cppcheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "executable", "cfg_dir", "platforms_dir", "licenses", "dependencies", "sbom_ref"],
          "properties": {
            "version": { "$ref": "#/$defs/version" },
            "executable": { "type": "string", "enum": ["analysis/cppcheck/cppcheck.exe", "analysis/cppcheck/cppcheck"] },
            "cfg_dir": { "type": "string", "const": "analysis/cppcheck/cfg" },
            "platforms_dir": { "type": "string", "const": "analysis/cppcheck/platforms" },
            "licenses": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/relativePath" },
                  { "pattern": "^analysis/cppcheck/licenses/" }
                ]
              },
              "allOf": [
                { "contains": { "const": "analysis/cppcheck/licenses/COPYING" } },
                { "contains": { "const": "analysis/cppcheck/licenses/simplecpp-LICENSE" } },
                { "contains": { "const": "analysis/cppcheck/licenses/tinyxml2-LICENSE" } },
                { "contains": { "const": "analysis/cppcheck/licenses/picojson-LICENSE" } }
              ]
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/relativePath" },
                  { "pattern": "^analysis/cppcheck/" }
                ]
              }
            },
            "sbom_ref": { "type": "string", "const": "byo-analysis:cppcheck" }
          }
        },
        "clangd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "executable", "resource_dir", "licenses", "dependencies", "sbom_ref"],
          "properties": {
            "version": { "$ref": "#/$defs/version" },
            "executable": { "type": "string", "enum": ["analysis/clangd/bin/clangd.exe", "analysis/clangd/bin/clangd"] },
            "resource_dir": { "type": "string", "pattern": "^analysis/clangd/lib/clang/[1-9][0-9]*$(?![\\s\\S])" },
            "licenses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  { "const": "analysis/clangd/LICENSE.TXT" },
                  {
                    "allOf": [
                      { "$ref": "#/$defs/relativePath" },
                      { "pattern": "^analysis/clangd/licenses/" }
                    ]
                  }
                ]
              },
              "contains": { "const": "analysis/clangd/LICENSE.TXT" }
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/relativePath" },
                  { "pattern": "^analysis/clangd/" }
                ]
              }
            },
            "sbom_ref": { "type": "string", "const": "byo-analysis:clangd" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        { "properties": { "platform": { "const": "windows" }, "architecture": { "const": "x86_64" } } },
        { "properties": { "platform": { "const": "macos" }, "architecture": { "enum": ["x86_64", "aarch64"] } } },
        { "properties": { "platform": { "const": "linux" }, "architecture": { "const": "x86_64" } } }
      ]
    },
    {
      "if": { "properties": { "platform": { "const": "windows" } } },
      "then": {
        "properties": { "programs": { "properties": {
          "cppcheck": { "properties": {
            "executable": { "const": "analysis/cppcheck/cppcheck.exe" },
            "dependencies": { "items": { "pattern": "^analysis/cppcheck/[^/]+\\.dll$(?![\\s\\S])" } }
          } },
          "clangd": { "properties": {
            "executable": { "const": "analysis/clangd/bin/clangd.exe" },
            "dependencies": { "items": { "pattern": "^analysis/clangd/bin/[^/]+\\.dll$(?![\\s\\S])" } }
          } }
        } } }
      },
      "else": {
        "properties": { "programs": { "properties": {
          "cppcheck": { "properties": { "executable": { "const": "analysis/cppcheck/cppcheck" } } },
          "clangd": { "properties": { "executable": { "const": "analysis/clangd/bin/clangd" } } }
        } } }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "macos" } } },
      "then": {
        "properties": { "programs": { "properties": {
          "cppcheck": { "properties": { "dependencies": { "items": { "pattern": "^analysis/cppcheck/lib/[^/]+\\.dylib$(?![\\s\\S])" } } } },
          "clangd": { "properties": { "dependencies": { "items": { "pattern": "^analysis/clangd/lib/[^/]+\\.dylib$(?![\\s\\S])" } } } }
        } } }
      }
    },
    {
      "if": { "properties": { "platform": { "const": "linux" } } },
      "then": {
        "properties": { "programs": { "properties": {
          "cppcheck": { "properties": {
            "dependencies": { "items": { "pattern": "^analysis/cppcheck/lib/[^/]+\\.so(?:\\.[0-9]+)*$(?![\\s\\S])" } },
            "licenses": { "allOf": [
              { "contains": { "const": "analysis/cppcheck/licenses/GCC-COPYING3" } },
              { "contains": { "const": "analysis/cppcheck/licenses/GCC-COPYING.RUNTIME" } }
            ] }
          } },
          "clangd": { "properties": { "dependencies": { "items": { "pattern": "^analysis/clangd/lib/[^/]+\\.so(?:\\.[0-9]+)*$(?![\\s\\S])" } } } }
        } } }
      }
    }
  ],
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[. ](?:/|$))[^/\\\\<>:\"|?*\\u0000-\\u001f]+(?:/[^/\\\\<>:\"|?*\\u0000-\\u001f]+)*$(?![\\s\\S])"
    }
  }
}
